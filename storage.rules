rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // 1. صور البروفايل والملف الشخصي
    match /avatars/{allPaths=**} {
      allow read: if true;
      allow write: if true;
    }

    // 2. الملفات والمستندات المرفقة بالشات
    match /chat_files/{allPaths=**} {
      allow read: if true;
      allow write: if true;
    }

    // 3. التسجيلات الصوتية في الشات
    match /voice_notes/{allPaths=**} {
      allow read: if true;
      allow write: if true;
    }

    // 4. ملفات المستخدم المباشرة
    match /users/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // 5. الملفات العامة
    match /public/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
